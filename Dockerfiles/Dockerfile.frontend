# ---------- Build stage ----------
FROM node:22-slim AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Base URL used by the compiled SPA to reach the backend through the NGINX proxy.
ARG REACT_APP_BASE_URL=/api/v1
ARG VITE_API_URL=/api/v1
ARG REACT_APP_RAZORPAY_KEY=rzp_test_Tb3EgbiAUuZQ4x

ENV REACT_APP_BASE_URL=$REACT_APP_BASE_URL \
    VITE_API_URL=$VITE_API_URL \
    REACT_APP_RAZORPAY_KEY=$REACT_APP_RAZORPAY_KEY \
    GENERATE_SOURCEMAP=false \
    CI=true

RUN npm run build
# ---------- Runtime stage ----------
FROM nginxinc/nginx-unprivileged:1.27-alpine
 
COPY Dockerfiles/nginx.conf /etc/nginx/conf.d/default.conf

COPY Dockerfiles/security-headers.conf /etc/nginx/snippets/security-headers.conf

COPY --from=build /app/build /usr/share/nginx/html
 
EXPOSE 8080
 
CMD ["nginx", "-g", "daemon off;"]
 
