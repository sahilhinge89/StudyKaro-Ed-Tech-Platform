# JWT Secret Key used for signing and verifying JSON Web Tokens
JWT_SECRET=

# MongoDB connection string for connecting to the database
MONGODB_URL=

# Hostname of the mail server used for sending emails
MAIL_HOST=

# Username of the email account used for sending emails
MAIL_USER=

# Password of the email account used for sending emails
MAIL_PASS=

# ---------------------------------------------------------------------------
# Production hardening
# ---------------------------------------------------------------------------

# Comma separated list of browser origins that may send credentialed
# requests to the API, e.g. "https://studykaro.example.com,https://www.example.com".
# Requests without an Origin header (same-origin navigation, curl, kubelet
# probes) are always allowed. Required when the SPA is served from a different
# host than the API. A value of "*" reflects the caller's origin.
CLIENT_ORIGINS=

# Number of reverse proxies in front of the API (NGINX container / Ingress).
# Required so that "secure" cookies and the real client IP are resolved from
# the X-Forwarded-* headers. Use "false" to disable proxy trust entirely.
TRUST_PROXY=1

# Attributes of the authentication cookie.
# COOKIE_SAME_SITE: lax (default) | strict | none
#   "none" requires COOKIE_SECURE=true and is only needed when the SPA runs
#   on a different site than the API.
# COOKIE_SECURE: true | false - left empty it is derived from the request
#   protocol (X-Forwarded-Proto), so HTTPS deployments are handled
#   automatically.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=
